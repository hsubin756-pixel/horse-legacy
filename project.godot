config_version=5

[application]
config/name="Horse Legacy"
config/version="0.4.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="horse-legacy"

[display]
window/size/viewport_width=1120
window/size/viewport_height=760
window/size/window_width_override=1120
window/size/window_height_override=760
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.09, 0.075, 1)
